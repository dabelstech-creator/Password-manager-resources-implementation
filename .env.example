# AuthPlatform API — copy values into the hosting provider's secret/environment manager.
# Do not commit real values or paste secret values into chat.

# PostgreSQL connection string from the managed database.
DATABASE_URL=

# Telegram Login / OpenID Connect client from @BotFather → Bot Settings → Login Widget.
# This is the OIDC client ID, not the Telegram Bot API token.
TELEGRAM_LOGIN_CLIENT_ID=

# WorkOS AuthKit environment
WORKOS_CLIENT_ID=
# Must exactly match the callback URI registered in WorkOS and the app's URL scheme.
# Example shape only: your-app-scheme://auth/callback
WORKOS_REDIRECT_URI_IOS=

# Canonical public HTTPS URLs
AUTHPLATFORM_PUBLIC_BASE_URL=
# Must point to a deployed HTTPS page that signs the user in with WorkOS and calls
# POST /device/approve. The approval frontend is a separate deployment.
AUTHPLATFORM_DEVICE_VERIFICATION_URL=

# Public OAuth device client identifier registered in AuthPlatform
AUTHPLATFORM_OAUTH_CLIENT_ID=
AUTHPLATFORM_ALLOWED_SCOPES=devices:read devices:write

# Generate a high-entropy random secret and set the SAME value in the Telegram bot runtime.
TELEGRAM_BOT_SHARED_SECRET=
